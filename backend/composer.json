{
  "name": "product-import/backend",
  "description": "Product Import API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.6",
    "doctrine/orm": "^3.3",
    "doctrine/dbal": "^4.2",
    "doctrine/migrations": "^3.4",
    "phpoffice/phpspreadsheet": "^3.7",
    "firebase/php-jwt": "^6.11",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.65",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/App/",
      "DoctrineMigrations\\": "src/Migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "cache-files-dir": "C:\\temp\\composer_cache"
  }
}
